{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://green-bond.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://green-bond.onrender.com/uploads/$1" },
    { "source": "/cdn/(.*)", "destination": "https://green-bond.onrender.com/cdn/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
