# GreenBond Frontend Environment Variables Example

# Backend & CDN API URLs
VITE_API_URL=https://green-bond.onrender.com
VITE_SOCKET_URL=https://green-bond.onrender.com
VITE_IMAGE_CDN_BASE_URL=https://green-bond.onrender.com/cdn

# Firebase Cloud Messaging (FCM) Client Web SDK Configuration
VITE_FIREBASE_API_KEY=AIzaSyA_your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_VAPID_KEY=BKagO_your_public_vapid_key_from_cloud_messaging_settings
