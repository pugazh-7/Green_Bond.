# GreenBond Express API environment template.
# Copy to backend/.env for local work, or configure these values in the hosting provider.
# Never commit backend/.env or put real credentials in this file.

# Server and database. PORT may be assigned by the hosting platform.
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=

# Public canonical frontend URL(s) used by Express CORS.
CLIENT_URL=
FRONTEND_URL=

# Payment gateway. Required only when Razorpay payments are enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin SDK credentials. Required only when server-side push notifications are enabled.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Marketplace service-area defaults. Optional; current code has defaults when omitted.
LAUNCH_CENTER_LAT=
LAUNCH_CENTER_LNG=
SERVICE_RADIUS_KM=
